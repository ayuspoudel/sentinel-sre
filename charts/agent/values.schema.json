{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },

    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },

    "env": {
      "type": "object",
      "properties": {
        "SENTINEL_SRE_URL": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["SENTINEL_SRE_URL"],
      "additionalProperties": {
        "type": "string"
      }
    },


    "tls": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["secretName"]
    },

    "webhook": {
      "type": "object",
      "properties": {
        "failurePolicy": {
          "type": "string",
          "enum": ["Fail", "Ignore"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": ["failurePolicy", "timeoutSeconds"]
    },

    "selectors": {
      "type": "object",
      "properties": {
        "namespaceLabel": {
          "type": "object",
          "properties": {
            "key": { "type": "string" },
            "value": { "type": "string" }
          },
          "required": ["key", "value"]
        },
        "workloadLabel": {
          "type": "object",
          "properties": {
            "key": { "type": "string" }
          },
          "required": ["key"]
        }
      },
      "required": ["namespaceLabel", "workloadLabel"]
    }
  },
  "required": [
    "image",
    "replicaCount",
    "env",
    "tls",
    "webhook",
    "selectors"
  ]
}
