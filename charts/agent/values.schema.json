{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",

  "properties": {
    "namespace": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "create": {
          "type": "boolean"
        }
      },
      "required": ["name", "create"],
      "additionalProperties": false
    },

    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["latest"]
          }
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"],
      "additionalProperties": false
    },

    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },

    "sentinelSRE": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    },

    "tls": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["secretName"],
      "additionalProperties": false
    },

    "webhook": {
      "type": "object",
      "properties": {
        "failurePolicy": {
          "type": "string",
          "enum": ["Fail", "Ignore"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": ["failurePolicy", "timeoutSeconds"],
      "additionalProperties": false
    },

    "selectors": {
      "type": "object",
      "properties": {
        "namespaceLabel": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["key", "value"],
          "additionalProperties": false
        },
        "workloadLabel": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$"
            }
          },
          "required": ["key"],
          "additionalProperties": false
        }
      },
      "required": ["namespaceLabel", "workloadLabel"],
      "additionalProperties": false
    }
  },

  "required": [
    "namespace",
    "image",
    "replicaCount",
    "sentinelSRE",
    "tls",
    "webhook",
    "selectors"
  ],

  "additionalProperties": false
}
